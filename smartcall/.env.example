# Copy to .env and fill in real values before running docker compose.

# PostgreSQL password (used by db + backend containers)
DB_PASSWORD=change-me-strong-password

# JWT signing secret — at least 32 random characters
JWT_SECRET=change-me-very-long-random-secret-string

# AES key for encrypting sensitive settings (OpenAI API key, SMTP password) at rest
DATA_KEY=change-me-another-long-random-secret

# Public URL of the site (used for CORS)
PUBLIC_URL=https://call.example.com

# Port the frontend/nginx listens on
HTTP_PORT=80

# TURN server credentials (coturn)
TURN_REALM=smartcall
TURN_USER=smartcall
TURN_PASSWORD=change-me-turn-password
